# ============================================================================
# CSSS 441 Book Catalog & DevSecOps Gates - Environment Configuration Template
# ============================================================================
# Copy this file to .env for local overrides. Do NOT commit production secrets.

PYTHONPATH=.

# Database Connection (Default: local SQLite database)
# For PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/book_catalog
DATABASE_URL=sqlite:///./book_catalog.db

# Administrator Authentication Key
# Protects book creation/editing/deletion and security report downloads
ADMIN_API_KEY=devsecops-admin-secret-2026

# Strict CORS Allowed Origins (Comma-separated list; leave empty for same-origin)
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Rate Limiting Settings
RATE_LIMIT_DEFAULT=200/minute
RATE_LIMIT_MUTATION=30/minute

# DefectDojo Integration (Optional for CI/CD)
# DEFECTDOJO_URL=https://defectdojo.example.com
# DEFECTDOJO_TOKEN=your-defectdojo-token-here
# DEFECTDOJO_ENGAGEMENT_ID=1

